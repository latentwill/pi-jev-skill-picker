{
  "name": "pi-jev-skill-picker",
  "version": "0.1.0",
  "description": "Keeps Pi's full Agent Skills catalog out of every model request and ranks skills for the current task with TypeSafe's Jev (System One) instead of a subagent fork.",
  "keywords": ["pi", "pi-extension", "skills", "typesafe", "jev", "system-one"],
  "license": "MIT",
  "type": "module",
  "files": ["extensions", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "engines": { "node": ">=22.6" },
  "pi": { "extensions": ["extensions/skill-jev.ts"] },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  }
}
